    given-names: Mikio
    email: maoi@ucsd.edu
    affiliation: "Halicioglu Data Science Institute, University of California San Diego"
  - family-names: Charles
    given-names: Adam
    email: adamsc@jhu.edu
    affiliation: "Biomedical Engineering Department, Johns Hopkins University"

# The Julia implementation in julia/src/ derives from Sai Koukuntla's DLDS
# package (github.com/saikoukunt/dLDS), which he has licensed GPL v3 for this
# use. He is credited as the upstream software author in the repository
# documentation and source headers. The dLDS method is cited in the manuscript
# as Mudrik et al. 2024.

license: MIT
repository-code: "https://github.com/YueWan1/social-dLDS"
version: "0.1.1"

keywords:
  - behavior
  - dynamical systems
  - pose estimation
  - mouse social behavior
  - keypoint-MoSeq

