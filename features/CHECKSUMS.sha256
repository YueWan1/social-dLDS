#   8a02654fddae28614ee24a6a082261b8  task1_classic_classification.zip  (457,357,950 B)

# CalMS21 videos, needed only for frame-overlay panels. Published MD5:
#   790b2ff6054c0889c3b0112b3a12eacc  task1_videos_mp4.zip  (28,286,565,405 B)

# To record local SHA-256 values after downloading:
#
#     cd "$RAW_ROOT"
#     sha256sum keypoint_moseq_zenodo_15171335/open_field_2D.zip \
#               calms21/readme.md \
#               calms21/calms21_convert_to_npy.py \
#               calms21/task1_classic_classification.zip \
#               calms21/task1_videos_mp4.zip
#
# Confirm the published MD5 before adding a SHA-256 value. Derived Zenodo
# bundles are omitted because their checksums are managed with the deposit.
