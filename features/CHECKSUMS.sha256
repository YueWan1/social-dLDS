# SHA-256 checksums for public files verified during release preparation.
# Paths are relative to `raw_data_root` in paths.yml. Check them with:
#
#     cd "$(sed -n 's/^raw_data_root: *//p' paths.yml)"
#     sha256sum -c /path/to/social-dLDS/features/CHECKSUMS.sha256
#
# The fetch scripts also verify downloads against the MD5 values published by
# Zenodo and CaltechDATA.

# Verified files
